// Add this block inside `match /databases/{database}/documents { ... }`
// in the Firestore rules of project motri-4ed44 (Firebase Console → Firestore Database → Rules).
// It sits next to the existing whispers / circuitLeaderboard / worldCounters/sinkhole rules.

    // Dahrooj shared visit counter: each signed-in visitor may only add one.
    match /worldCounters/dahrooj {
      allow read: if request.auth != null;
      function validVisit() {
        return request.auth != null
          && request.resource.data.keys().hasOnly(['count', 'lastUserId', 'updatedAt'])
          && request.resource.data.count is int
          && request.resource.data.count > 0
          && request.resource.data.count <= 9007199254740991
          && request.resource.data.lastUserId == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      allow create: if validVisit() && request.resource.data.count == 1;
      allow update: if validVisit() && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
