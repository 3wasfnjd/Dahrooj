{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dahrooj-duel",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": {"command": "npm run build"},
  "assets": {"directory": "./site", "binding": "ASSETS", "run_worker_first": ["/ws", "/health"]},
  "durable_objects": {"bindings": [{"name":"DUEL_LOBBY", "class_name":"DuelLobby"}]},
  "migrations": [{"tag":"duel-v1", "new_sqlite_classes":["DuelLobby"]}]
}
